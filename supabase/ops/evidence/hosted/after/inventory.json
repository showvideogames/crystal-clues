  "functions": [
    {
      "proname": "account_email",
      "args": "_user_id uuid",
      "result": "text",
      "security_definer": true,
      "lanname": "sql",
      "definition": "CREATE OR REPLACE FUNCTION public.account_email(_user_id uuid)\n RETURNS text\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\n  select coalesce(\n    (select nullif(btrim(i.identity_data ->> 'email'), '')\n       from public.accounts a\n       join auth.identities i on i.user_id = a.user_id\n      where a.user_id = _user_id\n        and i.provider = 'custom:platform'\n      order by i.created_at\n      limit 1),\n    (select u.email::text\n       from public.accounts a\n       join auth.users u on u.id = a.user_id\n      where a.user_id = _user_id)\n  )\n$function$\n"
    },
    {
      "proname": "cluevoyance_uid",
      "args": "",
      "result": "uuid",
      "security_definer": true,
      "lanname": "sql",
      "definition": "CREATE OR REPLACE FUNCTION public.cluevoyance_uid()\n RETURNS uuid\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\n  select a.user_id\n    from public.accounts a\n   where a.user_id = auth.uid()\n$function$\n"
    },
    {
      "proname": "delete_local_account",
      "args": "_user_id uuid",
      "result": "void",
      "security_definer": true,
      "lanname": "plpgsql",
      "definition": "CREATE OR REPLACE FUNCTION public.delete_local_account(_user_id uuid)\n RETURNS void\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\nbegin\n  if _user_id is null then\n    return;\n  end if;\n  -- Cluevoyance keeps no site-wide aggregates, so personal rows are simply\n  -- deleted (plays and admins also cascade from accounts).\n  delete from public.plays    where user_id = _user_id;\n  delete from public.admins   where user_id = _user_id;\n  delete from public.accounts where user_id = _user_id;\n  -- GoTrue's own cascades remove identities, sessions and refresh tokens.\n  delete from auth.users where id = _user_id;\nend;\n$function$\n"
    },
    {
      "proname": "delete_my_account",
      "args": "",
      "result": "boolean",
      "security_definer": true,
      "lanname": "plpgsql",
      "definition": "CREATE OR REPLACE FUNCTION public.delete_my_account()\n RETURNS boolean\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\ndeclare\n  _uid uuid := public.cluevoyance_uid();\nbegin\n  if _uid is null then\n    return false;\n  end if;\n  perform public.delete_local_account(_uid);\n  return true;\nend;\n$function$\n"
    },
    {
      "proname": "ensure_account",
      "args": "",
      "result": "TABLE(outcome text, user_id uuid, global_user_id text, email text, created_at timestamp with time zone, imported_losses integer)",
      "security_definer": true,
      "lanname": "plpgsql",
      "definition": "CREATE OR REPLACE FUNCTION public.ensure_account()\n RETURNS TABLE(outcome text, user_id uuid, global_user_id text, email text, created_at timestamp with time zone, imported_losses integer)\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\n#variable_conflict use_column\ndeclare\n  _uid uuid := auth.uid();\n  _gid text;\nbegin\n  if _uid is null then\n    return query select 'not_signed_in'::text, null::uuid, null::text, null::text, null::timestamptz, null::integer;\n    return;\n  end if;\n\n  -- The link is read from GoTrue's identity table, never from the client.\n  select i.provider_id\n    into _gid\n    from auth.identities i\n   where i.user_id = _uid\n     and i.provider = 'custom:platform'\n   order by i.created_at\n   limit 1;\n\n  if _gid is null then\n    -- An auth user that did not come through the shared sign-in (a dashboard\n    -- or test user, a stray signup). Not, and never becomes, an account.\n    return query select 'not_platform_linked'::text, null::uuid, null::text, null::text, null::timestamptz, null::integer;\n    return;\n  end if;\n\n  insert into public.accounts (user_id, global_user_id)\n  values (_uid, _gid)\n  on conflict (user_id) do update\n    set last_seen_at = now();\n\n  return query\n    select 'ok'::text, a.user_id, a.global_user_id, public.account_email(a.user_id), a.created_at, a.imported_losses\n      from public.accounts a\n     where a.user_id = _uid;\nend;\n$function$\n"
    },
    {
      "proname": "import_plays",
      "args": "_plays jsonb, _losses integer",
      "result": "TABLE(outcome text, imported integer, skipped integer)",
      "security_definer": true,
      "lanname": "plpgsql",
      "definition": "CREATE OR REPLACE FUNCTION public.import_plays(_plays jsonb, _losses integer DEFAULT 0)\n RETURNS TABLE(outcome text, imported integer, skipped integer)\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\ndeclare\n  _uid uuid := public.cluevoyance_uid();\n  _el jsonb;\n  _res text;\n  _imported int := 0;\n  _skipped int := 0;\n  _finished timestamptz;\nbegin\n  if _uid is null then\n    return query select 'not_signed_in'::text, 0, 0;\n    return;\n  end if;\n  if _plays is null or jsonb_typeof(_plays) <> 'array' then\n    return query select 'invalid'::text, 0, 0;\n    return;\n  end if;\n  if jsonb_array_length(_plays) > 5000 or coalesce(_losses, 0) > 100000 then\n    return query select 'too_many'::text, 0, 0;\n    return;\n  end if;\n\n  if coalesce(_losses, 0) > 0 then\n    update public.accounts set imported_losses = imported_losses + _losses where user_id = _uid;\n  end if;\n\n  for _el in select * from jsonb_array_elements(_plays) loop\n    begin\n      _finished := nullif(_el ->> 'finished_at', '')::timestamptz;\n    exception when others then\n      _finished := null;\n    end;\n    begin\n      _res := public.upsert_play(\n        _uid,\n        (_el ->> 'puzzle_id')::bigint,\n        (_el ->> 'solved')::boolean,\n        (_el ->> 'lives_used')::int,\n        _el ->> 'difficulty',\n        _finished,\n        'import');\n    exception when others then\n      _res := 'invalid';\n    end;\n    if _res = 'ok' then _imported := _imported + 1; else _skipped := _skipped + 1; end if;\n  end loop;\n\n  return query select 'ok'::text, _imported, _skipped;\nend;\n$function$\n"
    },
    {
      "proname": "is_cluevoyance_admin",
      "args": "",
      "result": "boolean",
      "security_definer": true,
      "lanname": "sql",
      "definition": "CREATE OR REPLACE FUNCTION public.is_cluevoyance_admin()\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\n  select exists (select 1 from public.admins ad where ad.user_id = public.cluevoyance_uid())\n$function$\n"
    },
    {
      "proname": "my_account",
      "args": "",
      "result": "TABLE(user_id uuid, global_user_id text, email text, created_at timestamp with time zone, imported_losses integer)",
      "security_definer": true,
      "lanname": "sql",
      "definition": "CREATE OR REPLACE FUNCTION public.my_account()\n RETURNS TABLE(user_id uuid, global_user_id text, email text, created_at timestamp with time zone, imported_losses integer)\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\n  select a.user_id, a.global_user_id, public.account_email(a.user_id), a.created_at, a.imported_losses\n    from public.accounts a\n   where a.user_id = auth.uid()\n$function$\n"
    },
    {
      "proname": "ping",
      "args": "",
      "result": "boolean",
      "security_definer": false,
      "lanname": "sql",
      "definition": "CREATE OR REPLACE FUNCTION public.ping()\n RETURNS boolean\n LANGUAGE sql\n STABLE\n SET search_path TO 'public'\nAS $function$ select true $function$\n"
    },
    {
      "proname": "record_play",
      "args": "_puzzle_id bigint, _solved boolean, _lives_used integer, _difficulty text",
      "result": "TABLE(outcome text)",
      "security_definer": true,
      "lanname": "plpgsql",
      "definition": "CREATE OR REPLACE FUNCTION public.record_play(_puzzle_id bigint, _solved boolean, _lives_used integer, _difficulty text)\n RETURNS TABLE(outcome text)\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\ndeclare\n  _uid uuid := public.cluevoyance_uid();\nbegin\n  if _uid is null then\n    return query select 'not_signed_in'::text;\n    return;\n  end if;\n  return query select public.upsert_play(_uid, _puzzle_id, _solved, _lives_used, _difficulty, now(), 'play');\nend;\n$function$\n"
    },
    {
      "proname": "upsert_play",
      "args": "_uid uuid, _puzzle_id bigint, _solved boolean, _lives_used integer, _difficulty text, _finished_at timestamp with time zone, _source text",
      "result": "text",
      "security_definer": true,
      "lanname": "plpgsql",
      "definition": "CREATE OR REPLACE FUNCTION public.upsert_play(_uid uuid, _puzzle_id bigint, _solved boolean, _lives_used integer, _difficulty text, _finished_at timestamp with time zone, _source text)\n RETURNS text\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\ndeclare\n  _date date;\nbegin\n  -- puzzles.date is text on the live project; a malformed value counts as unknown\n  begin\n    select nullif(btrim(p.date), '')::date into _date from public.puzzles p where p.id = _puzzle_id;\n  exception when others then\n    _date := null;\n  end;\n  if _date is null then\n    return 'unknown_puzzle';\n  end if;\n  if _solved is null or _lives_used is null or _lives_used < 0 or _lives_used > 3\n     or _difficulty is null or _difficulty not in ('easy', 'standard', 'expert', 'hardcore') then\n    return 'invalid';\n  end if;\n\n  insert into public.plays (user_id, puzzle_id, puzzle_date, solved, lives_used, difficulty, finished_at, source)\n  values (_uid, _puzzle_id, _date, _solved, _lives_used, _difficulty, coalesce(_finished_at, now()), _source)\n  on conflict (user_id, puzzle_id) do update\n    set solved      = public.plays.solved or excluded.solved,\n        -- a win keeps its own lives/difficulty; a loss may be upgraded by a later win\n        lives_used  = case when public.plays.solved then public.plays.lives_used  else excluded.lives_used  end,\n        difficulty  = case when public.plays.solved then public.plays.difficulty  else excluded.difficulty  end,\n        finished_at = case when public.plays.solved then public.plays.finished_at else excluded.finished_at end,\n        source      = case when public.plays.solved then public.plays.source      else excluded.source      end;\n  return 'ok';\nend;\n$function$\n"
    }
  ],
