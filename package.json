{
  "name": "crystal-clues",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "db:start": "supabase start -x realtime,storage-api,imgproxy,edge-runtime,logflare,vector,supavisor",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:status": "supabase status",
    "test": "npm run test:unit && npm run test:db && npm run test:friends",
    "test:unit": "vitest run",
    "test:db": "node --test --test-concurrency=1 tests/db/accounts.test.mjs",
    "test:friends": "npm run test:friends:db && npm run test:friends:api",
    "test:friends:db": "supabase test db",
    "test:friends:api": "node --test --test-concurrency=1 tests/friends/api.test.mjs tests/friends/share.test.mjs tests/friends/format.test.mjs",
    "test:friends:e2e": "node tests/friends/e2e.mjs",
    "test:friends:daily": "node tests/friends/daily-smoke.mjs",
    "test:friends:push": "node tests/friends/push-e2e.mjs",
    "friends:setup": "node tools/friends-local-setup.mjs",
    "friends:dev": "vite --mode friends-local --host 127.0.0.1 --port 5186 --strictPort",
    "workos": "node tools/workos.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^26.1.0",
    "puppeteer-core": "^25.12.0",
    "supabase": "^2.119.0",
    "vite": "^8.0.4",
    "vitest": "^3.2.7",
    "web-push": "^3.6.7"
  }
}
