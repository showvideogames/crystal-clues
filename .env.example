# Cluevoyance configuration. Copy to `.env` (git-ignored) for local work.
# Nothing here is secret: the publishable key and the discovery URL are
# public by design. There are NO defaults in code (decision D5): with the
# first two unset the app runs in offline guest-only mode on its sample puzzle.

# The Supabase project the game talks to (content, accounts, plays).
#   local stack:  http://127.0.0.1:55421  (from `npx supabase status`)
#   hosted beta:  set in Vercel project settings, never committed
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# The shared sign-in service's OpenID discovery document.
# Empty = accounts OFF (guest-only build). Hosted beta uses the WorkOS
# Staging domain, e.g. https://<name>.authkit.app/.well-known/openid-configuration
VITE_PLATFORM_DISCOVERY_URL=

# Emergency switch: "false" hides every sign-in surface without a schema change.
# VITE_ACCOUNTS_ENABLED=true
